# Distro-agnostic bootc image → SuperISO live environment transform.
#
# Key constraints:
# - Do not use the target distro's package manager (no dnf/apt/rpm-ostree in final).
# - Do not install Fedora livesys scripts.
# - Keep payload storage as overlay-driver containers-storage in a shared
#   squashfs additional image store (not VFS).
#
# This follows the useful Dakota/Tromso pattern: build a dmsquash-live initramfs
# in a Debian helper stage against the base image's kernel modules, then copy
# only the resulting initramfs into the final image.

ARG BASE_IMAGE
ARG FAMILY=unknown

FROM ${BASE_IMAGE} AS image-ref

FROM debian:sid AS initramfs-builder

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        dracut \
        dmsetup \
        kmod \
        systemd-boot-efi \
        zstd \
    && rm -rf /var/lib/apt/lists/*

COPY --from=image-ref /usr/lib/modules /usr/lib/modules
COPY src/dracut/95superiso-isofile /usr/lib/dracut/modules.d/95superiso-isofile
COPY src/dracut/95tbox-root /usr/lib/dracut/modules.d/95tbox-root

RUN set -ex; \
    kernel=$(find /usr/lib/modules -maxdepth 2 -name "modules.dep" -print | head -1 | xargs dirname | xargs basename); \
    echo "Building dmsquash-live initramfs for kernel ${kernel}"; \
    DRACUT_NO_XATTR=1 dracut -v --force --zstd --reproducible --no-hostonly \
        --add 'dmsquash-live superiso-isofile tbox-root' \
        --add-drivers 'squashfs overlay loop iso9660 sr_mod cdrom sd_mod usb-storage xhci-pci xhci_hcd virtio_blk virtio_pci virtio_scsi exfat vfat fat ntfs3 ext4 btrfs' \
        /tmp/initramfs.img "${kernel}"; \
    ls -lh /tmp/initramfs.img

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG FAMILY=unknown
ARG DESKTOP=unknown
ARG INSTALLER_CHANNEL=stable
ENV INSTALLER_CHANNEL=${INSTALLER_CHANNEL}

COPY --from=initramfs-builder /tmp/initramfs.img /tmp/initramfs.img
COPY --from=initramfs-builder /usr/lib/systemd/boot/efi /usr/lib/systemd/boot/efi
RUN set -ex; \
    kernel=$(find /usr/lib/modules -maxdepth 2 -name "modules.dep" -print | head -1 | xargs dirname | xargs basename); \
    mv /tmp/initramfs.img "/usr/lib/modules/${kernel}/initramfs.img"; \
    echo "Replaced initramfs for kernel ${kernel}"

# Family marker, installer config, and host-visible branding assets.
RUN mkdir -p /etc/superiso && echo "${FAMILY}" > /etc/superiso/family && echo "${DESKTOP}" > /etc/superiso/desktop
COPY src/etc/bootc-installer/images.${FAMILY}.json /etc/bootc-installer/images.json
COPY src/etc/bootc-installer/recipe.${FAMILY}.json /etc/bootc-installer/recipe.json
COPY src/share/bootc-installer/images /usr/share/bootc-installer/images
RUN mkdir -p /etc/bootc-installer && touch /etc/bootc-installer/live-iso-mode

# Install bootc-installer Flatpak from the Tuna installer continuous release.
COPY src/install-bootc-installer-flatpak.sh /tmp/install-bootc-installer-flatpak.sh
RUN --mount=type=cache,target=/var/cache/flatpak-dl,id=superiso-bootc-installer-flatpak \
    chmod +x /tmp/install-bootc-installer-flatpak.sh && \
    /tmp/install-bootc-installer-flatpak.sh && \
    rm -f /tmp/install-bootc-installer-flatpak.sh

# Shared overlay store + large /var/tmp scratch.  The store is mounted read-only
# and registered as an additional image store; the live image's primary store
# remains writable overlay storage in the live overlay.
COPY src/systemd/superiso-store.mount /etc/systemd/system/superiso-store.mount.in
COPY src/systemd/superiso-persist.mount /etc/systemd/system/superiso-persist.mount.in
COPY src/systemd/superiso-persist-setup.service /etc/systemd/system/superiso-persist-setup.service
COPY src/systemd/var-tmp.mount /etc/systemd/system/var-tmp.mount
COPY src/superiso-persist-setup /usr/local/libexec/superiso-persist-setup
RUN set -ex; \
    STORE_UNIT="$(systemd-escape --path /var/lib/superiso-store).mount"; \
    PERSIST_UNIT="$(systemd-escape --path /var/lib/superiso-persist).mount"; \
    mv /etc/systemd/system/superiso-store.mount.in "/etc/systemd/system/${STORE_UNIT}"; \
    mv /etc/systemd/system/superiso-persist.mount.in "/etc/systemd/system/${PERSIST_UNIT}"; \
    chmod +x /usr/local/libexec/superiso-persist-setup; \
    mkdir -p /etc/containers /var/lib/superiso-store /var/lib/superiso-persist /var/tmp; \
    chmod 1777 /var/tmp; \
    printf '[storage]\ndriver = "overlay"\nrunroot = "/run/containers/storage"\ngraphroot = "/var/lib/containers/storage"\n[storage.options]\nadditionalimagestores = ["/var/lib/superiso-store"]\n' \
        > /etc/containers/storage.conf; \
    systemctl enable "${STORE_UNIT}" "${PERSIST_UNIT}" superiso-persist-setup.service var-tmp.mount

# Hostname / motd.
RUN set -ex; \
    mkdir -p /usr/lib/tmpfiles.d; \
    echo "f /etc/hostname 0644 - - - superiso-live-${FAMILY}" > /usr/lib/tmpfiles.d/superiso-hostname.conf; \
    printf '\nSuperISO live (%s family)\nThe bootc-installer Flatpak autostarts; run `superiso-install` for a fisherman-backed headless flow.\n\n' "${FAMILY}" > /etc/motd

# Headless installer helper.  This uses fisherman, same backend as the
# bootc-installer Flatpak; direct user-facing bootc install is not supported.
COPY src/superiso-install /usr/local/bin/superiso-install
RUN chmod +x /usr/local/bin/superiso-install

# Distro-agnostic live session setup.  Use only existing tools/services when
# present.  No livesys scripts or package-manager installs.
RUN set -ex; \
    if ! id liveuser >/dev/null 2>&1; then \
        if command -v useradd >/dev/null 2>&1; then \
            useradd -m -u 1000 -U -G wheel,video,render -s /bin/bash liveuser 2>/dev/null || \
            useradd -m -u 1000 -U -s /bin/bash liveuser; \
        fi; \
    fi; \
    if command -v chpasswd >/dev/null 2>&1; then echo 'liveuser:live' | chpasswd || true; fi; \
    mkdir -p /etc/sudoers.d; \
    echo 'liveuser ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/liveuser; \
    chmod 0440 /etc/sudoers.d/liveuser; \
    grep -q '^liveuser ALL=(ALL) NOPASSWD: ALL' /etc/sudoers 2>/dev/null || \
        echo 'liveuser ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers; \
    \
    # Serial/TTY autologin for headless testing. \
    mkdir -p /etc/systemd/system/getty@tty1.service.d /etc/systemd/system/serial-getty@ttyS0.service.d; \
    printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin liveuser --noclear %%I $TERM\n' \
        > /etc/systemd/system/getty@tty1.service.d/autologin.conf; \
    printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin liveuser --keep-baud 115200,38400,9600 %%I $TERM\n' \
        > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf; \
    \
    # GNOME live autologin, Dakota-style, if GDM is present. \
    if [ -d /etc/gdm ] || [ -f /usr/lib/systemd/system/gdm.service ] || [ -f /lib/systemd/system/gdm.service ]; then \
        mkdir -p /etc/gdm /home/liveuser/.config; \
        printf '[daemon]\nAutomaticLoginEnable=True\nAutomaticLogin=liveuser\n' > /etc/gdm/custom.conf; \
        touch /home/liveuser/.config/gnome-initial-setup-done; \
        chown -R liveuser:liveuser /home/liveuser/.config 2>/dev/null || true; \
    fi; \
    \
    # KDE live autologin, Tromso-style, if SDDM is present. \
    if [ -d /etc/sddm.conf.d ] || [ -f /usr/lib/systemd/system/sddm.service ] || [ -f /lib/systemd/system/sddm.service ]; then \
        mkdir -p /etc/sddm.conf.d /etc/xdg; \
        printf '[General]\nDisplayServer=wayland\nCompositorCommand=kwin_wayland --no-lockscreen\n\n[Autologin]\nUser=liveuser\nSession=plasma\nRelogin=false\n' \
            > /etc/sddm.conf.d/live-autologin.conf; \
        printf '[Daemon]\nAutolock=false\nLockOnResume=false\n' > /etc/xdg/kscreenlockerrc; \
    fi; \
    \
    # Avoid suspend/lockouts during installs when systemd is present. \
    systemctl mask sleep.target suspend.target hibernate.target hybrid-sleep.target 2>/dev/null || true; \
    \
    # bootc-installer Flatpak autostart + polkit, Dakota/Tromso style. \
    INSTALLER_APP_ID='org.bootcinstaller.Installer'; \
    [ "${INSTALLER_CHANNEL:-stable}" = 'dev' ] && INSTALLER_APP_ID='org.bootcinstaller.Installer.Devel'; \
    mkdir -p /etc/xdg/autostart /usr/share/applications; \
    printf '[Desktop Entry]\nName=SuperISO Installer\nExec=flatpak run --env=VANILLA_CUSTOM_RECIPE=/run/host/etc/bootc-installer/recipe.json %s\nIcon=drive-harddisk\nType=Application\nX-GNOME-Autostart-enabled=true\nX-KDE-autostart-phase=2\n' "$INSTALLER_APP_ID" > /etc/xdg/autostart/superiso-installer.desktop; \
    printf '[Desktop Entry]\nName=SuperISO Installer\nComment=Install an embedded bootc image to disk\nExec=flatpak run --env=VANILLA_CUSTOM_RECIPE=/run/host/etc/bootc-installer/recipe.json %s\nIcon=drive-harddisk\nType=Application\nCategories=System;\nNoDisplay=false\n' "$INSTALLER_APP_ID" > /usr/share/applications/superiso-installer.desktop; \
    INSTALLER_APP_DIR=$(find /var/lib/flatpak/app/${INSTALLER_APP_ID} -name fisherman -type f 2>/dev/null | head -1 | xargs dirname 2>/dev/null || true); \
    if [ -n "$INSTALLER_APP_DIR" ]; then mkdir -p /usr/local/bin; ln -sf "${INSTALLER_APP_DIR}/fisherman" /usr/local/bin/fisherman; fi; \
    mkdir -p /usr/share/polkit-1/actions /etc/polkit-1/rules.d; \
    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">' '<policyconfig>' '  <action id="org.tunaos.Installer.install">' '    <description>Install an operating system to disk</description>' '    <message>Authentication is required to install an operating system</message>' '    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>' '    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/fisherman</annotate>' '    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>' '  </action>' '</policyconfig>' > /usr/share/polkit-1/actions/org.bootcinstaller.Installer.policy; \
    printf '%s\n' 'polkit.addRule(function(action, subject) {' '  if ((action.id === "org.freedesktop.policykit.exec" || action.id === "org.tunaos.Installer.install") && subject.user === "liveuser" && subject.local) {' '    return polkit.Result.YES;' '  }' '});' > /etc/polkit-1/rules.d/99-superiso-live-installer.rules; \
    \
    # Enable sshd only if the base already ships it. \
    if [ -f /usr/lib/systemd/system/sshd.service ] || [ -f /lib/systemd/system/sshd.service ]; then \
        mkdir -p /etc/systemd/system-preset; \
        echo 'enable sshd.service' > /etc/systemd/system-preset/90-superiso-ssh.preset; \
        mkdir -p /etc/ssh/sshd_config.d; \
        printf 'PasswordAuthentication yes\nPermitRootLogin no\n' > /etc/ssh/sshd_config.d/99-superiso-live.conf; \
        mkdir -p /etc/firewalld/zones; \
        printf '%s\n' '<?xml version="1.0" encoding="utf-8"?>' '<zone>' '  <short>Public</short>' '  <service name="ssh"/>' '  <service name="mdns"/>' '  <service name="dhcpv6-client"/>' '</zone>' > /etc/firewalld/zones/public.xml; \
        systemctl enable sshd 2>/dev/null || true; \
    fi
