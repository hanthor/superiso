[Unit]
Description=Super-ISO shared containers-storage (loop-mounted from live media)
DefaultDependencies=no
# dmsquash-live mounts the live media at /run/initramfs/live before we run.
After=systemd-remount-fs.service local-fs-pre.target
Before=local-fs.target
ConditionPathExists=/run/initramfs/live/LiveOS/store.squashfs.img

[Mount]
# Read-only mount path.  Exposed to containers-storage as an
# `additionalimagestore` (read-only) via /etc/containers/storage.conf so
# bootc install can find images here without needing to acquire write
# locks on the squashfs.  The primary store stays at the default
# /var/lib/containers/storage (writable, tmpfs-backed in the live overlay).
What=/run/initramfs/live/LiveOS/store.squashfs.img
Where=/var/lib/superiso-store
Type=squashfs
Options=loop,ro,nodev

[Install]
WantedBy=local-fs.target
